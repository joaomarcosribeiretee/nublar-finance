{
  "name": "@nublar/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,desktop \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/outfit": "^5.2.8",
    "@nublar/validation": "workspace:*",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nublar/eslint-config": "workspace:*",
    "@nublar/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "eslint": "^9.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
