# Supabase → Project Settings → Database → Connection string → URI
# Use the direct connection on port 5432. Do not use the transaction pooler (6543).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
PORT=3333
DESKTOP_ORIGIN=http://localhost:5173
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Supabase → Project Settings → API → publishable (anon) key
SUPABASE_ANON_KEY=
